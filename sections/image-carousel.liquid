{% comment %}
  Image Carousel Section
  - Fully responsive, infinite loop
  - Direction control
  - Added: Background and Border settings
{% endcomment %}

<div class="carousel-wrapper" 
     style="overflow:hidden; 
            position:relative; 
            background-color: {{ section.settings.bg_color }}; 
            border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
            padding: {{ section.settings.padding_vertical }}px 0;">
  
  <div class="carousel-track 
              {% if section.settings.direction == 'right' %}scroll-right{% else %}scroll-left{% endif %}" 
       style="display:flex; gap:{{ section.settings.image_spacing }}px;">
    
    {% for block in section.blocks %}
      {% if block.settings.carousel_image != blank %}
        <div class="carousel-item" style="flex:0 0 auto; height:{{ section.settings.image_height }}px;">
          {% if block.settings.carousel_link != blank %}
            <a href="{{ block.settings.carousel_link }}">
              <img src="{{ block.settings.carousel_image | img_url: '800x' }}" 
                   alt="Carousel Image" 
                   style="height:100%; width:auto; object-fit:cover; border-radius:8px;">
            </a>
          {% else %}
            <img src="{{ block.settings.carousel_image | img_url: '800x' }}" 
                 alt="Carousel Image" 
                 style="height:100%; width:auto; object-fit:cover; border-radius:8px;">
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {%- comment -%} Duplicate images for seamless infinite scroll {%- endcomment -%}
    {% for block in section.blocks %}
      {% if block.settings.carousel_image != blank %}
        <div class="carousel-item" style="flex:0 0 auto; height:{{ section.settings.image_height }}px;">
          {% if block.settings.carousel_link != blank %}
            <a href="{{ block.settings.carousel_link }}">
              <img src="{{ block.settings.carousel_image | img_url: '800x' }}" 
                   alt="Carousel Image Duplicate" 
                   style="height:100%; width:auto; object-fit:cover; border-radius:8px;">
            </a>
          {% else %}
            <img src="{{ block.settings.carousel_image | img_url: '800x' }}" 
                 alt="Carousel Image Duplicate" 
                 style="height:100%; width:auto; object-fit:cover; border-radius:8px;">
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  @keyframes scroll-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scroll-right {
    0%   { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .carousel-wrapper {
    width: 100%;
    max-width: 100%;
    /* Ensure border doesn't increase width beyond 100% causing scrollbars */
    box-sizing: border-box; 
  }

  .carousel-track.scroll-left {
    animation: scroll-left {{ section.settings.scroll_speed }}s linear infinite;
  }

  .carousel-track.scroll-right {
    animation: scroll-right {{ section.settings.scroll_speed }}s linear infinite;
  }

  .carousel-track {
    will-change: transform;
  }

  .carousel-item img {
    display:block;
  }

  @media (max-width: 768px) {
    .carousel-item {
      height: 250px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Image Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width (px)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds)",
      "min": 5,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (px)",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 400
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Spacing between images (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "left", "label": "Left to Right" },
        { "value": "right", "label": "Right to Left" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Carousel Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "carousel_image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "carousel_link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Carousel"
    }
  ]
}
{% endschema %}