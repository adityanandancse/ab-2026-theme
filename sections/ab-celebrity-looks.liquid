{%- comment -%}
  Celebrity looks — all looks render in ONE horizontal row. The row is centred
  when the looks fit and scrolls horizontally (never wraps) when they overflow.
  Desktop gets prev/next arrows (shown only on overflow); touch uses native scroll.

  Each look reuses the theme's _hotspot-product block, so the hotspot dots and
  popovers are driven by the existing product-hotspot.js. That script clamps each
  dialog inside its look's own box (its parentElement = .hotspots-container), and
  every look box sits inside the track's content box, so the dialogs are NOT
  clipped by the track's overflow. We also close any open popover on track scroll.

  Background/text follow the collection-list / media-with-content pattern: an
  explicit background_color fed through contrast-override, which emits scoped
  --color-* vars on .color-custom-{section.id}; .section-background paints
  --color-background. (This theme does not use color-scheme-N classes.)

  Cards match the Wardrobes (collection-list) section: a fixed 4/5 (portrait)
  media box with a white rounded frame. Because 4/5 can crop the source image,
  the background image uses object-fit:cover / object-position:center; hotspot
  x/y percentages are relative to this (possibly cropped) box.
{%- endcomment -%}

{%- comment -%}
  Hotspots are driven by this section's own scoped <celebrity-looks-carousel>
  element (see the javascript block below): it reads each hotspot's product data
  from the server-rendered markup and builds a native [popover] card in the top
  layer. We intentionally do NOT load product-hotspot.js — it fetched the product
  (GET /products/<handle>) and failed to render. No fetch, no dependency on it.
{%- endcomment -%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'product-badges-styles' %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    ab-celebrity-looks
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  data-testid="ab-celebrity-looks"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --hotspot-size: 36px;
    --minimum-width-dialog: 260px;
    --maximum-width-dialog: 330px;
    --width-product-image-dialog: 110px;
    --product-title-gap: {{ section.settings.product_title_gap }}px;
    --ab-frame-color: {{ settings.color_palette.background }};
  "
>
  <div class="ab-celebrity-looks__inner">
    <div class="ab-celebrity-looks__header">
      {% content_for 'block', type: 'text', id: 'eyebrow' %}
      {% content_for 'block', type: 'text', id: 'heading' %}
    </div>

    <celebrity-looks-carousel class="ab-celebrity-looks__carousel" data-section-id="{{ section.id }}">
      <button
        type="button"
        class="ab-celebrity-looks__arrow ab-celebrity-looks__arrow--prev button button-unstyled button-unstyled--transparent flip-x"
        data-looks-prev
        aria-label="{{ 'accessibility.slideshow_previous' | t | default: 'Previous look' }}"
        hidden
      >
        <span class="svg-wrapper icon-arrow">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </button>

      <div class="ab-celebrity-looks__row" data-looks-track>
        {% content_for 'blocks' %}
      </div>

      <button
        type="button"
        class="ab-celebrity-looks__arrow ab-celebrity-looks__arrow--next button button-unstyled button-unstyled--transparent"
        data-looks-next
        aria-label="{{ 'accessibility.slideshow_next' | t | default: 'Next look' }}"
        hidden
      >
        <span class="svg-wrapper icon-arrow">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </button>
    </celebrity-looks-carousel>
  </div>
</div>

{% stylesheet %}
  .ab-celebrity-looks__inner {
    width: 100%;
  }

  /* Heading shares the track's container; its text alignment is set by the
   * template's heading block, so its start lines up with the track container. */
  .ab-celebrity-looks__header {
    width: 100%;
    /* Matches wardrobes: heading pad-end (8px) + section gap (12px) = 20px to cards. */
    margin-block-end: 12px;
  }

  .ab-celebrity-looks__carousel {
    position: relative;
    display: block;
    width: 100%;
  }

  /* Single horizontal track: never wraps; centred when it fits, scrolls from the
   * start when it overflows (auto margins on the end children do the centring and
   * collapse to 0 on overflow; `safe center` is a modern reinforcement). */
  .ab-celebrity-looks__row {
    /* Matches wardrobes columns_gap (12px). */
    --looks-colgap: 12px;

    display: flex;
    flex-wrap: nowrap;
    gap: var(--looks-colgap);
    justify-content: safe center;
    align-items: flex-start;
    width: 100%;

    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-block-end: 12px; /* room for the scrollbar so it doesn't overlap images */

    /* Thin scrollbar in the theme's muted foreground */
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / 0.3) transparent;
  }

  .ab-celebrity-looks__row::-webkit-scrollbar {
    height: 4px;
  }

  .ab-celebrity-looks__row::-webkit-scrollbar-track {
    background: transparent;
  }

  .ab-celebrity-looks__row::-webkit-scrollbar-thumb {
    background: rgb(var(--color-foreground-rgb) / 0.3);
    border-radius: 2px;
  }

  /* Fallback centring for browsers without `safe` keyword support. */
  .ab-celebrity-looks__row > :first-child {
    margin-inline-start: auto;
  }

  .ab-celebrity-looks__row > :last-child {
    margin-inline-end: auto;
  }

  .ab-look {
    flex: 0 0 auto;
    width: calc((100% - 3 * var(--looks-colgap)) / 4);
    scroll-snap-align: start;
  }

  /* Media box matches the wardrobes card: fixed 4/5 (portrait) ratio with a
   * white rounded frame. overflow stays visible so the hotspot popover can
   * extend beyond the image; the track's content box still contains the look
   * box, so nothing is clipped by the scroller. */
  .ab-look__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: visible;
    border: 1px solid var(--ab-frame-color, #ffffff);
    border-radius: 10px;
    background-color: var(--ab-frame-color, #ffffff);
  }

  /* 4/5 can crop the source; cover + centred position (set globally on
   * .hotspots__background-image) keeps the garment centred. Round the image to
   * sit inside the frame without clipping the popovers. */
  .ab-celebrity-looks .hotspots__background-image {
    border-radius: 10px;
  }

  .ab-celebrity-looks .hotspots-container {
    overflow: visible;
  }

  /* The dot's clickable element is .hotspot-trigger (sized --hotspot-size). Give
   * it a >=44px transparent hit area so taps/clicks land reliably without
   * enlarging the visible dot, and keep it above the image and clickable. The
   * parent .hotspot box is --button-size but is not the click target. */
  .ab-celebrity-looks .hotspot-trigger {
    pointer-events: auto;
    z-index: var(--layer-raised, 2);
    overflow: visible;
  }

  .ab-celebrity-looks .hotspot-trigger::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(44px, 100%);
    height: max(44px, 100%);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    /* transparent hit area only — no background */
  }

  /* Prev/next arrows: desktop (fine pointer) only, and only when overflowing. */
  .ab-celebrity-looks__arrow {
    display: none;
    position: absolute;
    top: calc(50% - 6px);
    transform: translateY(-50%);
    z-index: 3;
  }

  .ab-celebrity-looks__arrow--prev {
    inset-inline-start: 0;
  }

  .ab-celebrity-looks__arrow--next {
    inset-inline-end: 0;
  }

  .ab-celebrity-looks__arrow[disabled] {
    opacity: 0.35;
    pointer-events: none;
  }

  @media (min-width: 990px) and (hover: hover) {
    .ab-celebrity-looks__arrow:not([hidden]) {
      display: inline-flex;
    }
  }

  /* Touch devices: hide the scrollbar, use native momentum scroll. */
  @media (hover: none) {
    .ab-celebrity-looks__row {
      scrollbar-width: none;
    }

    .ab-celebrity-looks__row::-webkit-scrollbar {
      display: none;
    }
  }

  /* Mobile (<750px): match the Wardrobes collection-list carousel — full-bleed
   * single swipe row, 60vw cards start-aligned at the page margin, 12px gap,
   * scroll-snap, next card peeking. NO container-type anywhere: it would make
   * .ab-look the containing block for the absolutely-positioned hotspot popover
   * and mis-place/clip it. Dots are sized from the card width with vw instead of
   * container-query units (60vw card -> 7% ~= 4.2vw, same visual as the old
   * 7cqi). Desktop (>=990px) and tablet (750-989px, where Wardrobes shows its
   * 4-up grid) are untouched. */
  @media screen and (max-width: 749px) {
    .ab-celebrity-looks__row {
      justify-content: flex-start;
      width: 100vw;
      margin-inline: calc(50% - 50vw);
      padding-inline: var(--util-page-margin-offset, 20px);
      scroll-padding-inline-start: var(--util-page-margin-offset, 20px);
    }

    .ab-celebrity-looks__row > :first-child {
      margin-inline-start: 0;
    }

    .ab-celebrity-looks__row > :last-child {
      margin-inline-end: 0;
    }

    .ab-look {
      width: clamp(150px, 60vw, 450px);
    }

    .ab-look__media {
      --hotspot-size: clamp(18px, 4.2vw, 32px) !important;
    }
  }

  /* The stock <dialog> is only a data source now (JS reads its image/price);
   * never show it. Our own native [popover] card replaces it. */
  .ab-celebrity-looks .hotspot-dialog {
    display: none !important;
  }

  /* Native popover product card (top layer, so the scroll track never clips it).
   * Appended to <body> by the section's JS; styled here. */
  .ab-hotspot-card {
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(320px, calc(100vw - 32px));
    padding: 0;
    background-color: #33251c;
    color: #fff6e4;
    border: 1px solid #453b33;
    border-radius: 0;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .ab-hotspot-card::backdrop {
    background: transparent;
  }

  .ab-hotspot-card__inner {
    display: grid;
    gap: 10px;
    padding: 12px;
  }

  .ab-hotspot-card__close {
    position: absolute;
    top: 6px;
    inset-inline-end: 6px;
    z-index: 2;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: rgb(22 16 13 / 0.55);
    color: #fff6e4;
    border: 0;
    border-radius: 50%;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  .ab-hotspot-card__media {
    display: block;
    width: 100%;
  }

  .ab-hotspot-card__media img,
  .ab-hotspot-card__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ab-hotspot-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1rem;
    line-height: 1.2;
  }

  .ab-hotspot-card__price,
  .ab-hotspot-card__price * {
    color: #dbbf7c;
  }

  /* AB secondary / outline button: transparent, cream border + text, gold on
   * hover, uppercase + tracked. */
  .ab-hotspot-card__cta {
    display: inline-grid;
    align-content: center;
    justify-items: center;
    width: 100%;
    padding: 13px 20px;
    font-family: var(--font-accent--family);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff6e4;
    background: transparent;
    box-shadow: inset 0 0 0 1px #fff6e4;
    transition: color 0.2s ease, box-shadow 0.2s ease;
  }

  .ab-hotspot-card__cta:hover {
    color: #dbbf7c;
    box-shadow: inset 0 0 0 1px #dbbf7c;
  }

  /* Mobile: bottom sheet (no JS positioning needed). */
  @media screen and (max-width: 749px) {
    .ab-hotspot-card {
      inset: auto 0 0 0;
      width: 100%;
      max-width: 100%;
      max-height: 70vh;
      overflow-y: auto;
      border-inline: 0;
      border-block-end: 0;
      border-radius: 14px 14px 0 0;
    }

    .ab-hotspot-card::backdrop {
      background: rgb(0 0 0 / 0.4);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ab-hotspot-card {
      transition: opacity 0.2s ease, translate 0.2s ease;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('celebrity-looks-carousel')) {
    class CelebrityLooksCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-looks-track]');
        this.prevButton = this.querySelector('[data-looks-prev]');
        this.nextButton = this.querySelector('[data-looks-next]');
        if (!this.track) return;

        this.update = this.update.bind(this);
        this.onScroll = this.onScroll.bind(this);
        this.reposition = this.reposition.bind(this);
        this.builtCards = [];
        this.openCard = null;
        this.openTrigger = null;

        if (this.prevButton) this.prevButton.addEventListener('click', () => this.scrollByLook(-1));
        if (this.nextButton) this.nextButton.addEventListener('click', () => this.scrollByLook(1));
        this.track.addEventListener('scroll', this.onScroll, { passive: true });
        // Page scroll / resize reposition an open card; track scroll (onScroll) closes it.
        window.addEventListener('resize', this.reposition, { passive: true });
        window.addEventListener('scroll', this.reposition, { passive: true });

        if ('ResizeObserver' in window) {
          this.resizeObserver = new ResizeObserver(this.update);
          this.resizeObserver.observe(this.track);
        } else {
          window.addEventListener('resize', this.update);
        }

        this.update();
        this.setupHotspots();
      }

      disconnectedCallback() {
        if (this.resizeObserver) this.resizeObserver.disconnect();
        else window.removeEventListener('resize', this.update);
        if (this.track) this.track.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.reposition);
        window.removeEventListener('scroll', this.reposition);
        (this.builtCards || []).forEach((card) => card.remove());
        this.builtCards = [];
      }

      // Build a native [popover] product card per hotspot from the server-rendered
      // product data (image/title/price/url already in the DOM) — no fetch, no
      // dependency on product-hotspot.js. Hotspots with no product get nothing.
      setupHotspots() {
        const sectionId = this.dataset.sectionId || 'sec';
        this.querySelectorAll('product-hotspot-component').forEach((comp) => {
          const url = comp.getAttribute('data-product-url');
          const trigger = comp.querySelector('.hotspot-trigger');
          if (!url || !trigger) return;

          const dialog = comp.querySelector('.hotspot-dialog');
          const title = comp.getAttribute('data-product-title') || '';
          const id = 'ab-pop-' + sectionId + '-' + (comp.getAttribute('data-id') || '');

          const imgEl =
            dialog &&
            dialog.querySelector('.hotspot-dialog__product-image, .hotspot-dialog__placeholder-product-image');
          const priceEl = dialog && dialog.querySelector('.hotspot-dialog__product-price');
          const imageHTML = imgEl ? imgEl.outerHTML : '';
          const priceHTML = priceEl ? priceEl.innerHTML : '';

          const stale = document.getElementById(id);
          if (stale) stale.remove();

          const card = document.createElement('div');
          card.id = id;
          card.className = 'ab-hotspot-card';
          card.setAttribute('popover', 'auto');
          card.setAttribute('role', 'dialog');
          card.setAttribute('aria-label', title);
          card.innerHTML =
            '<button type="button" class="ab-hotspot-card__close" data-close aria-label="Close">&times;</button>' +
            '<div class="ab-hotspot-card__inner">' +
            (imageHTML ? '<span class="ab-hotspot-card__media">' + imageHTML + '</span>' : '') +
            '<p class="ab-hotspot-card__title"></p>' +
            (priceHTML ? '<div class="ab-hotspot-card__price">' + priceHTML + '</div>' : '') +
            '<a class="ab-hotspot-card__cta"></a>' +
            '</div>';
          // Set text/href via properties to avoid HTML injection from the title.
          card.querySelector('.ab-hotspot-card__title').textContent = title;
          const cta = card.querySelector('.ab-hotspot-card__cta');
          cta.setAttribute('href', url);
          cta.textContent = 'View piece';

          document.body.appendChild(card);
          this.builtCards.push(card);

          // Turn the existing dot into the native popover invoker; drop the
          // borrowed declarative handler so it can never fire/fetch.
          trigger.setAttribute('popovertarget', id);
          trigger.setAttribute('aria-haspopup', 'dialog');
          trigger.setAttribute('aria-label', 'View ' + title);
          trigger.removeAttribute('on:click');

          const closeBtn = card.querySelector('[data-close]');
          if (closeBtn) closeBtn.addEventListener('click', () => card.hidePopover());

          card.addEventListener('toggle', (event) => {
            if (event.newState === 'open') {
              this.openCard = card;
              this.openTrigger = trigger;
              this.positionCard(card, trigger);
            } else if (this.openCard === card) {
              this.openCard = null;
              this.openTrigger = null;
            }
          });
        });
      }

      // Desktop (>=750px): place the card next to its dot, preferring the right,
      // flipping left/up to stay in the viewport, 12px offset. Mobile uses the
      // CSS bottom sheet, so clear any inline coords.
      positionCard(card, trigger) {
        if (window.matchMedia('(max-width: 749px)').matches) {
          card.style.left = '';
          card.style.top = '';
          return;
        }
        const rect = trigger.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        const vh = document.documentElement.clientHeight;
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;
        const GAP = 12;

        let left = rect.right + GAP;
        if (left + cw > vw - 8) left = rect.left - GAP - cw; // flip to the left
        if (left < 8) left = Math.max(8, Math.min(rect.left, vw - cw - 8));

        let top = rect.top + rect.height / 2 - ch / 2;
        if (top + ch > vh - 8) top = vh - ch - 8; // keep within viewport bottom
        if (top < 8) top = 8;

        card.style.left = left + 'px';
        card.style.top = top + 'px';
      }

      reposition() {
        if (this.openCard && this.openTrigger) this.positionCard(this.openCard, this.openTrigger);
      }

      lookStep() {
        const look = this.track.querySelector('.ab-look');
        if (!look) return this.track.clientWidth;
        const styles = getComputedStyle(this.track);
        const gap = parseFloat(styles.columnGap || styles.gap) || 0;
        return look.getBoundingClientRect().width + gap;
      }

      scrollByLook(direction) {
        this.track.scrollBy({ left: direction * this.lookStep(), behavior: 'smooth' });
      }

      onScroll() {
        this.closePopovers();
        this.update();
      }

      // Close any open card on track scroll so it can't linger half-scrolled.
      closePopovers() {
        (this.builtCards || []).forEach((card) => {
          try {
            if (card.matches(':popover-open')) card.hidePopover();
          } catch (e) {}
        });
      }

      update() {
        const track = this.track;
        const overflowing = track.scrollWidth - track.clientWidth > 1;
        const atStart = track.scrollLeft <= 1;
        const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;

        if (this.prevButton) {
          this.prevButton.hidden = !overflowing;
          this.prevButton.disabled = atStart;
        }
        if (this.nextButton) {
          this.nextButton.hidden = !overflowing;
          this.nextButton.disabled = atEnd;
        }
      }
    }

    customElements.define('celebrity-looks-carousel', CelebrityLooksCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Celebrity looks",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "ab-look"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Hotspots"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot color",
      "default": "#FFFFFF57",
      "alpha": true
    },
    {
      "type": "color",
      "id": "bullseye_color",
      "label": "Bullseye color",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "range",
      "id": "product_title_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "product_title_preset",
      "label": "Product title",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "product_price_preset",
      "label": "Product price",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Celebrity looks",
      "settings": {
        "background_color": "#241A14"
      },
      "blocks": {
        "eyebrow": {
          "type": "text",
          "static": true,
          "settings": {
            "text": "<p>AS SEEN ON</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.75rem",
            "line_height": "normal",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "pretty",
            "text_color": "#e7ce93",
