{% doc %}
  @prompt
    Create a Shopify section named "PDF or Page Grid (Animated Popup)".
    
    Each block in the section should let me upload:
    
    A cover image,
    
    A title (optional),
    
    A URL link (which can be either a PDF file or an HTML page).
    
    The section should:
    
    Display all blocks in a responsive grid layout (3–4 columns depending on screen size).
    
    When the cover image is clicked:
    
    If the link ends with .pdf, open the PDF inside a lightbox popup with a smooth fade-in and slide-up animation.
    
    If it’s an HTML page, open it in a new browser tab.
    
    Include a close button (×) inside the popup that smoothly rotates on hover.
    
    The popup should fade out when closed.
    
    Use only HTML, CSS, and vanilla JavaScript — no external libraries.
    
    Include a clean, minimal, elegant style consistent with Achin Bindlish’s couture aesthetic — refined transitions, rounded corners, soft shadows.
    
    Add schema settings so I can add multiple blocks with their own image, title, and link in the theme editor., Give all the customisations possible, Give option to manually upload pdf, that open in lightbox, Give option to shoe the list as carousel and Grid with customisations
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pdf-grid-item-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform {{ block.settings.hover_animation_speed }}s ease, box-shadow {{ block.settings.hover_animation_speed }}s ease;
    background-color: {{ block.settings.card_background_color }};
    box-shadow: 0 {{ block.settings.card_shadow_size }}px {{ block.settings.card_shadow_size | times: 2 }}px {{ block.settings.card_shadow_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-pdf-grid-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift_distance }}px) {% if block.settings.hover_scale %}scale({{ block.settings.hover_scale_amount }}){% endif %};
    box-shadow: 0 {{ block.settings.hover_shadow_size }}px {{ block.settings.hover_shadow_size | times: 2.5 }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-pdf-grid-item-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-fit: {{ block.settings.image_fit }};
    display: block;
    transition: transform {{ block.settings.hover_animation_speed }}s ease, opacity {{ block.settings.hover_animation_speed }}s ease;
  }

  {% if block.settings.image_hover_zoom %}
    .ai-pdf-grid-item-{{ ai_gen_id }}:hover .ai-pdf-grid-item-image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.image_zoom_amount }});
    }
  {% endif %}

  {% if block.settings.image_hover_opacity %}
    .ai-pdf-grid-item-{{ ai_gen_id }}:hover .ai-pdf-grid-item-image-{{ ai_gen_id }} {
      opacity: {{ block.settings.image_hover_opacity_amount }};
    }
  {% endif %}

  .ai-pdf-grid-item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: {{ block.settings.placeholder_background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-pdf-grid-item-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: {{ block.settings.placeholder_icon_opacity }};
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-pdf-grid-item-title-{{ ai_gen_id }} {
    padding: {{ block.settings.title_padding_vertical }}px {{ block.settings.title_padding_horizontal }}px;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.title_alignment }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {% if block.settings.title_uppercase %}uppercase{% else %}none{% endif %};
    line-height: {{ block.settings.title_line_height }};
  }

  .ai-pdf-lightbox-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.lightbox_overlay_color }};
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ block.settings.lightbox_animation_speed }}s ease, visibility {{ block.settings.lightbox_animation_speed }}s ease;
    backdrop-filter: blur({{ block.settings.lightbox_blur }}px);
  }

  .ai-pdf-lightbox-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-pdf-lightbox-content-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.lightbox_width }}%;
    max-width: {{ block.settings.lightbox_max_width }}px;
    height: {{ block.settings.lightbox_height }}vh;
    background-color: {{ block.settings.lightbox_background_color }};
    border-radius: {{ block.settings.lightbox_border_radius }}px;
    box-shadow: 0 {{ block.settings.lightbox_shadow_size }}px {{ block.settings.lightbox_shadow_size | times: 3 }}px {{ block.settings.lightbox_shadow_color }};
    transform: translateY({{ block.settings.lightbox_slide_distance }}px) scale({{ block.settings.lightbox_initial_scale }});
    transition: transform {{ block.settings.lightbox_animation_speed }}s ease;
    overflow: hidden;
    border: {{ block.settings.lightbox_border_width }}px solid {{ block.settings.lightbox_border_color }};
  }

  .ai-pdf-lightbox-{{ ai_gen_id }}.active .ai-pdf-lightbox-content-{{ ai_gen_id }} {
    transform: translateY(0) scale(1);
  }

  .ai-pdf-lightbox-close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.close_button_position }}px;
    right: {{ block.settings.close_button_position }}px;
    width: {{ block.settings.close_button_size }}px;
    height: {{ block.settings.close_button_size }}px;
    background-color: {{ block.settings.close_button_background }};
    border: {{ block.settings.close_button_border_width }}px solid {{ block.settings.close_button_border_color }};
    border-radius: {% if block.settings.close_button_rounded %}50%{% else %}{{ block.settings.close_button_border_radius }}px{% endif %};
    color: {{ block.settings.close_button_color }};
    font-size: {{ block.settings.close_button_icon_size }}px;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform {{ block.settings.close_button_animation_speed }}s ease, background-color {{ block.settings.close_button_animation_speed }}s ease;
    box-shadow: 0 2px 8px {{ block.settings.close_button_shadow_color }};
  }

  .ai-pdf-lightbox-close-{{ ai_gen_id }}:hover {
    transform: rotate({{ block.settings.close_button_rotation }}deg) {% if block.settings.close_button_hover_scale %}scale({{ block.settings.close_button_scale_amount }}){% endif %};
    background-color: {{ block.settings.close_button_hover_background }};
    color: {{ block.settings.close_button_hover_color }};
  }

  .ai-pdf-lightbox-iframe-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media screen and (max-width: 749px) {
    .ai-pdf-lightbox-content-{{ ai_gen_id }} {
      width: {{ block.settings.lightbox_width_mobile }}%;
      height: {{ block.settings.lightbox_height_mobile }}vh;
    }

    .ai-pdf-grid-item-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size_mobile }}px;
      padding: {{ block.settings.title_padding_vertical_mobile }}px {{ block.settings.title_padding_horizontal_mobile }}px;
    }

    .ai-pdf-lightbox-close-{{ ai_gen_id }} {
      width: {{ block.settings.close_button_size_mobile }}px;
      height: {{ block.settings.close_button_size_mobile }}px;
      font-size: {{ block.settings.close_button_icon_size_mobile }}px;
    }
  }
{% endstyle %}

<div {{ block.shopify_attributes }}>
  <div
    class="ai-pdf-grid-item-{{ ai_gen_id }}"
    data-pdf-file="{{ block.settings.pdf_file }}"
    data-link-url="{{ block.settings.link_url }}"
  >
    {% if block.settings.cover_image %}
      <img
        src="{{ block.settings.cover_image | image_url: width: 600 }}"
        alt="{{ block.settings.title | escape }}"
        loading="lazy"
        width="{{ block.settings.cover_image.width }}"
        height="{{ block.settings.cover_image.height }}"
        class="ai-pdf-grid-item-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-pdf-grid-item-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.title != blank %}
      <div class="ai-pdf-grid-item-title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </div>
    {% endif %}
  </div>
</div>

<div class="ai-pdf-lightbox-{{ ai_gen_id }}" id="ai-pdf-lightbox-{{ ai_gen_id }}">
  <div class="ai-pdf-lightbox-content-{{ ai_gen_id }}">
    <button
      class="ai-pdf-lightbox-close-{{ ai_gen_id }}"
      aria-label="Close"
    >
      ×
    </button>
    <iframe class="ai-pdf-lightbox-iframe-{{ ai_gen_id }}"></iframe>
  </div>
</div>

<script>
  (function() {
    const gridItem = document.querySelector('.ai-pdf-grid-item-{{ ai_gen_id }}');
    const lightbox = document.getElementById('ai-pdf-lightbox-{{ ai_gen_id }}');
    const closeBtn = lightbox.querySelector('.ai-pdf-lightbox-close-{{ ai_gen_id }}');
    const iframe = lightbox.querySelector('.ai-pdf-lightbox-iframe-{{ ai_gen_id }}');

    if (gridItem) {
      gridItem.addEventListener('click', function() {
        const pdfFile = this.getAttribute('data-pdf-file');
        const linkUrl = this.getAttribute('data-link-url');
        
        if (pdfFile) {
          iframe.src = pdfFile;
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        } else if (linkUrl) {
          if (linkUrl.toLowerCase().endsWith('.pdf')) {
            iframe.src = linkUrl;
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
          } else {
            window.open(linkUrl, '_blank');
          }
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
        setTimeout(function() {
          iframe.src = '';
        }, {{ block.settings.lightbox_animation_speed | times: 1000 }});
      });
    }

    if (lightbox) {
      lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox) {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
          setTimeout(function() {
            iframe.src = '';
          }, {{ block.settings.lightbox_animation_speed | times: 1000 }});
        }
      });
    }
  })();
</script>

