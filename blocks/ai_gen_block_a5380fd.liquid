{% doc %}
  @prompt
    Create a block for blog grid, give option to show multiple blogs upto 8

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-blog-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blog-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-blog-grid__title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-blog-grid__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: {{ block.settings.subtitle_size }}px;
  }

  .ai-blog-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;}

  .ai-blog-grid__article-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-blog-grid__article-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .ai-blog-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
  }

  .ai-blog-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-blog-grid__article-{{ ai_gen_id }}:hover .ai-blog-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-blog-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-blog-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-blog-grid__content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-blog-grid__date-{{ ai_gen_id }} {
    color: {{ block.settings.meta_color }};
    font-size: 14px;
    margin-bottom: 8px;
    display: block;
  }

  .ai-blog-grid__blog-name-{{ ai_gen_id }} {
    color: {{ block.settings.blog_name_color }};
    font-size: 12px;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
  }

  .ai-blog-grid__article-title-{{ ai_gen_id }} {
    color: {{ block.settings.article_title_color }};
    margin: 0 0 12px;
    font-size: {{ block.settings.article_title_size }}px;
    line-height: 1.3;
  }

  .ai-blog-grid__article-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;}

  .ai-blog-grid__article-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-blog-grid__excerpt-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .ai-blog-grid__read-more-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .ai-blog-grid__read-more-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-blog-grid__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-blog-grid__empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 16px;
    font-size: 24px;
  }

  .ai-blog-grid__empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 16px;
  }

  @media screen and (max-width: 990px) {
    .ai-blog-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-blog-grid__container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-blog-grid__content-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<div class="ai-blog-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank %}
      <div class="ai-blog-grid__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blog-grid__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-blog-grid__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign all_articles = ''
      assign selected_blogs = ''
      
      for i in (1..8)
        assign blog_key = 'blog_' | append: i
        assign blog = block.settings[blog_key]
        
        if blog != blank
          assign selected_blogs = selected_blogs | append: blog.handle | append: ','
          for article in blog.articles
            assign all_articles = all_articles | append: article.id | append: '|' | append: article.title | append: '|' | append: article.url | append: '|' | append: article.published_at | append: '|' | append: article.excerpt | append: '|' | append: article.image | append: '|' | append: blog.title | append: '||'
          endfor
        endif
      endfor
      
      assign articles_array = all_articles | split: '||'
      assign sorted_articles = articles_array | sort
    %}

    {% if selected_blogs != blank %}
      <div class="ai-blog-grid__grid-{{ ai_gen_id }}">
        {% assign article_count = 0 %}
        {% for i in (1..8) %}
          {% assign blog_key = 'blog_' | append: i %}
          {% assign blog = block.settings[blog_key] %}
          {% if blog != blank %}
            {% for article in blog.articles %}
              {% if article_count < block.settings.articles_to_show %}
                <article class="ai-blog-grid__article-{{ ai_gen_id }}">
                  <div class="ai-blog-grid__image-wrapper-{{ ai_gen_id }}">
                    {% if article.image %}
                      <img
                        src="{{ article.image | image_url: width: 600 }}"
                        alt="{{ article.image.alt | escape }}"
                        class="ai-blog-grid__image-{{ ai_gen_id }}"
                loading="lazy"width="600"
                        height="{{ block.settings.image_height }}"
                      >
                    {% else %}
                      <div class="ai-blog-grid__image-placeholder-{{ ai_gen_id }}">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="ai-blog-grid__content-{{ ai_gen_id }}">
                    {% if block.settings.show_blog_name %}
                      <span class="ai-blog-grid__blog-name-{{ ai_gen_id }}">{{ blog.title }}</span>
                    {% endif %}

                    {% if block.settings.show_date %}
                      <time class="ai-blog-grid__date-{{ ai_gen_id }}" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                        {{ article.published_at | date: '%B %d, %Y' }}
                      </time>
                    {% endif %}

                <h3 class="ai-blog-grid__article-title-{{ ai_gen_id }}">
                      <a href="{{ article.url }}">{{ article.title }}</a>
                    </h3>

                    {% if block.settings.show_excerpt and article.excerpt != blank %}
                      <div class="ai-blog-grid__excerpt-{{ ai_gen_id }}">
                        {{ article.excerpt | truncate: block.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    {% if block.settings.show_read_more %}
                      <a href="{{ article.url }}" class="ai-blog-grid__read-more-{{ ai_gen_id }}">
                        {{ block.settings.read_more_text }}</a>
                    {% endif %}
                  </div>
                </article>
                {% assign article_count = article_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-blog-grid__empty-state-{{ ai_gen_id }}">
        <h3>No blogs selected</h3>
        <p>Select one or more blogs to display articles in this grid.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
