{% doc %}
  @prompt
    Add a size chart button to manually upload size charts for different collections

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-{{ ai_gen_id }} {
    display: inline-block;
    position: relative;
  }

  .ai-size-chart-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-size-chart-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-size-chart-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-size-chart-modal-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;padding: 20px;box-sizing: border-box;
  }

  .ai-size-chart-modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-size-chart-modal-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.modal_background_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    max-width: {{ block.settings.modal_max_width }}px;
    max-height: 90vh;
    width: 100%;
    position: relative;
    overflow: hidden;transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .ai-size-chart-modal-{{ ai_gen_id }}.active .ai-size-chart-modal-content-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-size-chart-modal-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid {{ block.settings.modal_border_color }};
  }

  .ai-size-chart-modal-title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.modal_text_color }};
    font-size: {{ block.settings.modal_title_size }}px;
  }

  .ai-size-chart-close-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.modal_text_color }};
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .ai-size-chart-close-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.modal_border_color }};
  }

  .ai-size-chart-modal-body-{{ ai_gen_id }} {
    padding: 20px;
    max-height: calc(90vh - 120px);
    overflow-y: auto;
  }

  .ai-size-chart-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.chart_border_radius }}px;
  }

  .ai-size-chart-placeholder-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    background-color: #f8f8f8;
    border-radius: {{ block.settings.chart_border_radius }}px;
    text-align: center;
  }

  .ai-size-chart-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .ai-size-chart-placeholder-text-{{ ai_gen_id }} {
    color: #666;
    font-size: 16px;
    margin: 0;
  }

  .ai-size-chart-collection-selector-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-size-chart-collection-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .ai-size-chart-collection-tab-{{ ai_gen_id }} {
    padding: 8px 16px;
    background-color: {{ block.settings.tab_background_color }};
    color: {{ block.settings.tab_text_color }};
    border: 1px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .ai-size-chart-collection-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_background_color }};
  }

  .ai-size-chart-collection-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_background_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-size-chart-modal-{{ ai_gen_id }} {
      padding: 10px;
    }

    .ai-size-chart-modal-content-{{ ai_gen_id }} {
      max-width: 100%;
      max-height: 95vh;
    }

    .ai-size-chart-modal-header-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-size-chart-modal-body-{{ ai_gen_id }} {
      padding: 15px;
      max-height: calc(95vh - 100px);
    }

    .ai-size-chart-collection-tabs-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<size-chart-{{ ai_gen_id }} class="ai-size-chart-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <button
    class="ai-size-chart-button-{{ ai_gen_id }}"
    aria-label="Open size chart"
    type="button"
  >
    {% if block.settings.show_icon %}
      <svg
        class="ai-size-chart-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <line x1="9" y1="9" x2="9" y2="15"/>
        <line x1="15" y1="9" x2="15" y2="15"/><line x1="9" y1="12" x2="15" y2="12"/>
      </svg>
    {% endif %}
    {{ block.settings.button_text }}
  </button>

  <div class="ai-size-chart-modal-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-labelledby="size-chart-title-{{ ai_gen_id }}">
    <div class="ai-size-chart-modal-content-{{ ai_gen_id }}">
      <div class="ai-size-chart-modal-header-{{ ai_gen_id }}">
        <h2 id="size-chart-title-{{ ai_gen_id }}" class="ai-size-chart-modal-title-{{ ai_gen_id }}">
          {{ block.settings.modal_title }}
        </h2>
        <button
          class="ai-size-chart-close-button-{{ ai_gen_id }}"
          aria-label="Close size chart"
          type="button"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="ai-size-chart-modal-body-{{ ai_gen_id }}">
        {% assign has_charts = false %}
        {% for i in (1..5) %}
          {% assign collection_key = 'collection_' | append: i %}
          {% assign chart_key = 'size_chart_' | append: i %}
          {% if block.settings[collection_key] != blank and block.settings[chart_key] != blank %}
            {% assign has_charts = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if has_charts %}
          <div class="ai-size-chart-collection-tabs-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              {% assign collection_key = 'collection_' | append: i %}
              {% assign chart_key = 'size_chart_' | append: i %}
              {% assign collection = block.settings[collection_key] %}
              {% assign chart = block.settings[chart_key] %}
              {% if collection != blank and chart != blank %}
                <button
                  class="ai-size-chart-collection-tab-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
                  data-collection="{{ i }}"
                  type="button"
                >
                  {{ collection.title }}
                </button>
              {% endif %}
            {% endfor %}
          </div>

          {% for i in (1..5) %}
            {% assign collection_key = 'collection_' | append: i %}
            {% assign chart_key = 'size_chart_' | append: i %}
            {% assign collection = block.settings[collection_key] %}
            {% assign chart = block.settings[chart_key] %}
            
            {% if collection != blank and chart != blank %}
              <div
                class="ai-size-chart-content-{{ ai_gen_id }}"
                data-collection="{{ i }}"
                {% unless forloop.first %}style="display: none;"{% endunless %}
              >
                <img
                  src="{{ chart | image_url: width: 1200}}"
                  alt="Size chart for {{ collection.title }}"
                  class="ai-size-chart-image-{{ ai_gen_id }}"
                  loading="lazy"width="{{ chart.width }}"
                  height="{{ chart.height }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="ai-size-chart-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <p class="ai-size-chart-placeholder-text-{{ ai_gen_id }}">
              Add size charts for your collections in the block settings
            </p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</size-chart-{{ ai_gen_id }}>

<script>
  (function() {
    class SizeChart{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('.ai-size-chart-button-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-size-chart-modal-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-size-chart-close-button-{{ ai_gen_id }}');
        this.tabs = this.querySelectorAll('.ai-size-chart-collection-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-size-chart-content-{{ ai_gen_id }}');}

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.button.addEventListener('click', () => this.openModal());
        this.closeButton.addEventListener('click', () => this.closeModal());
        this.modal.addEventListener('click', (e) => {
          if (e.target === this.modal) {
            this.closeModal();
          }
        });document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });

        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => this.switchTab(tab));
        });
      }

      openModal() {
        this.modal.classList.add('active');document.body.style.overflow = 'hidden';
        this.closeButton.focus();
      }

      closeModal() {
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
        this.button.focus();
      }

      switchTab(activeTab) {
        const collectionId = activeTab.dataset.collection;
        
        this.tabs.forEach(tab => {
          tab.classList.remove('active');
        });
        activeTab.classList.add('active');

        this.contents.forEach(content => {
          if (content.dataset.collection === collectionId) {
            content.style.display = 'block';
          } else {
            content.style.display = 'none';
          }
        });
      }
    }

    customElements.define('size-chart-{{ ai_gen_id }}', SizeChart{{ ai_gen_id }});
  })();
</script>

