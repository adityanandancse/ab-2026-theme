{% comment %} {% doc %}
  @prompt
    Create a block for instapost grid that redirects to the post page.  i'll just put the ig post link, give all aspect ratio options including adapt to image

{% enddoc %} {% endcomment %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instapost-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-instapost-item-{{ ai_gen_id }} {
    position: relative;
    {% unless block.settings.aspect_ratio == 'adapt' %}
      aspect-ratio: {{ block.settings.aspect_ratio }};
    {% endunless %}border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;transition: transform 0.3s ease, box-shadow 0.3s ease;background-color: #f4f4f4;
  }

  .ai-instapost-item-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .ai-instapost-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .ai-instapost-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    {% if block.settings.aspect_ratio == 'adapt' %}
      object-fit: contain;
    {% else %}
      object-fit: cover;
    {% endif %}transition: transform 0.3s ease;
  }

  .ai-instapost-item-{{ ai_gen_id }}:hover .ai-instapost-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-instapost-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.3) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-instapost-item-{{ ai_gen_id }}:hover .ai-instapost-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-instapost-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    color: white;
  }

  .ai-instapost-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    {% unless block.settings.aspect_ratio == 'adapt' %}
      min-height: 200px;
    {% else %}
      min-height: 150px;
    {% endunless %}
  }

  .ai-instapost-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;color: #999;margin-bottom: 12px;
  }

  .ai-instapost-empty-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-instapost-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;padding: {{ block.settings.section_padding | times: 0.75 }}px;
    }

    .ai-instapost-icon-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }
  }
{% endstyle %}

<div
  class="ai-instapost-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% for i in (1..9) %}
    {% liquid
      assign post_image_key = 'post_' | append: i | append: '_image'
      assign post_link_key = 'post_' | append: i | append: '_link'
      assign post_image = block.settings[post_image_key]
      assign post_link = block.settings[post_link_key]
    %}

    {% if post_image != blank or post_link != blank %}
      <div class="ai-instapost-item-{{ ai_gen_id }}">
        {% if post_link != blank %}
          <a
            href="{{ post_link }}"
            class="ai-instapost-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener noreferrer"aria-label="View Instagram post {{ i }}"
          >{% endif %}

        {% if post_image != blank %}
          <img
            src="{{ post_image | image_url: width: 500 }}"
            alt="Instagram post {{ i }}"
            class="ai-instapost-image-{{ ai_gen_id }}"
            loading="lazy"
            width="500"
            height="500"
          ><div class="ai-instapost-overlay-{{ ai_gen_id }}">
            <svg
              class="ai-instapost-icon-{{ ai_gen_id }}"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
