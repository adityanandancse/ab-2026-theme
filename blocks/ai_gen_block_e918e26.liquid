{% doc %}
  @prompt
    an interactive vertical step by step process with image and it should highlights as the user scrolls

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-step-process-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
  }

  .ai-step-timeline-{{ ai_gen_id }} {
    flex: 0 0 300px;
    position: sticky;
    top: 100px;
    height: fit-content;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
  }

  .ai-step-timeline-item-{{ ai_gen_id }} {
    position: relative;
    padding: 20px 0 20px 40px;
    border-left: 2px solid {{ block.settings.inactive_line_color }};
    transition: all 0.3s ease;
  }

  .ai-step-timeline-item-{{ ai_gen_id }}:last-child {
    border-left-color: transparent;
  }

  .ai-step-timeline-item-{{ ai_gen_id }}.active {
    border-left-color: {{ block.settings.active_line_color }};
  }

  .ai-step-timeline-item-{{ ai_gen_id }}.active .ai-step-timeline-number-{{ ai_gen_id }} {
    background-color: {{ block.settings.active_step_color }};
    color: {{ block.settings.active_step_text_color }};transform: scale(1.1);
  }

  .ai-step-timeline-item-{{ ai_gen_id }}.active .ai-step-timeline-title-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
    font-weight: 600;
  }

  .ai-step-timeline-number-{{ ai_gen_id }} {
    position: absolute;
    left: -12px;
    top: 20px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: {{ block.settings.inactive_step_color }};
    color: {{ block.settings.inactive_step_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .ai-step-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.inactive_text_color }};
    margin: 0 0 8px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-step-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.4;
  }

  .ai-step-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-step-content-item-{{ ai_gen_id }} {
    min-height: 100vh;
    padding: 60px 0;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .ai-step-content-item-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-step-content-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 30px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-step-content-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-step-content-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-step-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-step-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-step-content-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_title_size }}px;
    color: {{ block.settings.content_title_color }};
    margin: 0 0 20px;}

  .ai-step-content-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_text_size }}px;
    color: {{ block.settings.content_text_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 768px) {
    .ai-step-process-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-step-timeline-{{ ai_gen_id }} {
      flex: none;
      position: static;
      max-height: none;
      display: flex;
      overflow-x: auto;
      padding-bottom: 10px;
    }

    .ai-step-timeline-item-{{ ai_gen_id }} {
      flex: 0 0 auto;
      min-width: 200px;
      border-left: none;
      border-bottom: 2px solid {{ block.settings.inactive_line_color }};
      padding: 0 20px 20px 0;
      margin-right: 20px;
    }

    .ai-step-timeline-item-{{ ai_gen_id }}.active {
      border-bottom-color: {{ block.settings.active_line_color }};
    }

    .ai-step-timeline-number-{{ ai_gen_id }} {
      position: static;
      margin-bottom: 10px;
    }

    .ai-step-content-item-{{ ai_gen_id }} {
      min-height: auto;
      padding: 30px 0;
    }
  }
{% endstyle %}

<scroll-steps-{{ ai_gen_id }}
  class="ai-step-process-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-step-timeline-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign step_enabled_key = 'step_' | append: i | append: '_enabled'
        assign step_title_key = 'step_' | append: i | append: '_title'
        assign step_description_key = 'step_' | append: i | append: '_description'

        assign step_enabled = block.settings[step_enabled_key]
        assign step_title = block.settings[step_title_key]
        assign step_description = block.settings[step_description_key]
      %}

      {% if step_enabled %}
        <div
          class="ai-step-timeline-item-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-step="{{ i }}"
        >
          <div class="ai-step-timeline-number-{{ ai_gen_id }}">{{ forloop.index }}</div>
          <h3 class="ai-step-timeline-title-{{ ai_gen_id }}">{{ step_title }}</h3>
          {% if step_description != blank %}
            <p class="ai-step-timeline-description-{{ ai_gen_id }}">{{ step_description }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-step-content-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign step_enabled_key = 'step_' | append: i | append: '_enabled'
        assign step_image_key = 'step_' | append: i | append: '_image'
        assign step_content_title_key = 'step_' | append: i | append: '_content_title'
        assign step_content_text_key = 'step_' | append: i | append: '_content_text'

        assign step_enabled = block.settings[step_enabled_key]
        assign step_image = block.settings[step_image_key]
        assign step_content_title = block.settings[step_content_title_key]
        assign step_content_text = block.settings[step_content_text_key]
      %}

      {% if step_enabled %}
        <div
          class="ai-step-content-item-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-step="{{ i }}"
        >
          <div class="ai-step-content-image-{{ ai_gen_id }}">
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 800 }}"
                alt="{{ step_image.alt | escape }}"
                loading="lazy"
                width="{{ step_image.width }}"
                height="{{ step_image.height }}"
              >
            {% else %}
              <div class="ai-step-content-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-step-empty-state-{{ ai_gen_id }}">
                  Add an image for step {{ forloop.index }}
                </div>
              </div>
            {% endif %}
          </div>

          {% if step_content_title != blank %}
            <h2 class="ai-step-content-title-{{ ai_gen_id }}">{{ step_content_title }}</h2>
          {% endif %}

          {% if step_content_text != blank %}
            <div class="ai-step-content-text-{{ ai_gen_id }}">{{ step_content_text }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</scroll-steps-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollSteps{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.timelineItems = [];
        this.contentItems = [];
        this.currentStep = 1;
        this.isScrolling = false;
      }

      connectedCallback() {
        this.timelineItems = this.querySelectorAll('.ai-step-timeline-item-{{ ai_gen_id }}');
        this.contentItems = this.querySelectorAll('.ai-step-content-item-{{ ai_gen_id }}');
        
        this.setupScrollObserver();
        this.setupClickHandlers();
      }

      setupScrollObserver() {
        const options = {
          root: null,
          rootMargin: '-50% 0px -50% 0px',
          threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
          if (this.isScrolling) return;

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const stepNumber = parseInt(entry.target.dataset.step);
              this.activateStep(stepNumber);
            }
          });
        }, options);

        this.contentItems.forEach((item) => {
          observer.observe(item);
        });
      }

      setupClickHandlers() {
        this.timelineItems.forEach((item) => {
          item.addEventListener('click', () => {
            const stepNumber = parseInt(item.dataset.step);
            this.scrollToStep(stepNumber);
          });
        });
      }

      activateStep(stepNumber) {
        if (this.currentStep === stepNumber) return;
        
        this.currentStep = stepNumber;

        this.timelineItems.forEach((item) => {
          const itemStep = parseInt(item.dataset.step);
          item.classList.toggle('active', itemStep === stepNumber);
        });

        this.contentItems.forEach((item) => {
          const itemStep = parseInt(item.dataset.step);
          item.classList.toggle('active', itemStep === stepNumber);
        });
      }

      scrollToStep(stepNumber) {
        this.isScrolling = true;
        
        const targetContent = this.querySelector(`[data-step="${stepNumber}"].ai-step-content-item-{{ ai_gen_id }}`);
        if (targetContent) {
          targetContent.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

          setTimeout(() => {
            this.isScrolling = false;
          }, 1000);
        }
      }
    }

    customElements.define('scroll-steps-{{ ai_gen_id }}', ScrollSteps{{ ai_gen_id }});
  })();
</script>

