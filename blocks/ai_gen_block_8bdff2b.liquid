      "type": "color",
      "id": "overlay_color",
      "label": "Color",
      "default": "rgba(0, 0, 0, 0.4)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Opacity",
      "default": 0.3
    },
    {
      "type": "range",
