{% doc %}
  @prompt
    A magazine-style  Image Grid with all the customizations possiblr

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    max-width: 100%;
  }

  .ai-magazine-grid-{{ ai_gen_id }}--layout-masonry {
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    grid-auto-rows: {{ block.settings.row_height }}px;
  }

  .ai-magazine-grid-{{ ai_gen_id }}--layout-uniform {
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    grid-auto-rows: {{ block.settings.uniform_height }}px;
  }

  .ai-magazine-grid-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.item_background_color }};
    transition: transform {{ block.settings.hover_animation_duration }}s ease;
  }

  {% if block.settings.hover_effect == 'lift' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.hover_lift_distance }}px);
      box-shadow: 0 {{ block.settings.hover_lift_distance | times: 2 }}px {{ block.settings.hover_lift_distance | times: 4 }}px rgba(0, 0, 0, 0.15);
    }
  {% elsif block.settings.hover_effect == 'scale' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover {
      transform: scale({{ block.settings.hover_scale_factor }});
    }
  {% elsif block.settings.hover_effect == 'rotate' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover {
      transform: rotate({{ block.settings.hover_rotate_degrees }}deg);
    }
  {% endif %}

  .ai-magazine-grid-item-{{ ai_gen_id }}--span-2 {
    grid-column: span 2;
  }

  .ai-magazine-grid-item-{{ ai_gen_id }}--span-3 {
    grid-column: span 3;
  }

  .ai-magazine-grid-item-{{ ai_gen_id }}--tall {
    grid-row: span 2;
  }

  .ai-magazine-grid-item-{{ ai_gen_id }}--extra-tall {
    grid-row: span 3;
  }

  .ai-magazine-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
    transition: transform {{ block.settings.hover_animation_duration }}s ease;
  }

  {% if block.settings.image_hover_effect == 'zoom' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.image_zoom_factor }});
    }
  {% elsif block.settings.image_hover_effect == 'blur' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-image-{{ ai_gen_id }} {
      filter: blur({{ block.settings.image_blur_amount }}px);
    }
  {% elsif block.settings.image_hover_effect == 'grayscale' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-image-{{ ai_gen_id }} {
      filter: grayscale(100%);
    }
  {% endif %}

  .ai-magazine-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-magazine-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-magazine-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.9);
    padding: 8px 12px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .ai-magazine-grid-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity {{ block.settings.hover_animation_duration }}s ease;
  }

  {% if block.settings.overlay_hover_effect == 'fade_out' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-overlay-{{ ai_gen_id }} {
      opacity: 0;
    }
  {% elsif block.settings.overlay_hover_effect == 'fade_in' %}
    .ai-magazine-grid-overlay-{{ ai_gen_id }} {
      opacity: 0;
    }
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-overlay-{{ ai_gen_id }} {
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }
  {% endif %}

  .ai-magazine-grid-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.content_background }};
    transform: translateY({{ block.settings.content_initial_offset }}%);
    transition: transform {{ block.settings.hover_animation_duration }}s ease;
  }

  {% if block.settings.content_hover_effect == 'slide_up' %}
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-content-{{ ai_gen_id }} {
      transform: translateY(0);
    }
  {% elsif block.settings.content_hover_effect == 'slide_down' %}
    .ai-magazine-grid-content-{{ ai_gen_id }} {
      transform: translateY(-100%);
    }
    .ai-magazine-grid-item-{{ ai_gen_id }}:hover .ai-magazine-grid-content-{{ ai_gen_id }} {
      transform: translateY(0);
    }
  {% endif %}

  .ai-magazine-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-magazine-grid-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    font-weight: {{ block.settings.subtitle_font_weight }};
    margin: 0;
    opacity: 0.8;
    line-height: 1.3;
  }

  .ai-magazine-grid-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    text-decoration: none;
  }

  @media screen and (max-width: 990px) {
    .ai-magazine-grid-{{ ai_gen_id }}--layout-masonry,
    .ai-magazine-grid-{{ ai_gen_id }}--layout-uniform {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-magazine-grid-item-{{ ai_gen_id }}--span-2,
    .ai-magazine-grid-item-{{ ai_gen_id }}--span-3 {
      grid-column: span 1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-grid-{{ ai_gen_id }}--layout-masonry,
    .ai-magazine-grid-{{ ai_gen_id }}--layout-uniform {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-magazine-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
      padding: {{ block.settings.section_padding | times: 0.7 }}px;
    }

    .ai-magazine-grid-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.8 }}px;
    }

    .ai-magazine-grid-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-magazine-grid-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-magazine-grid-{{ ai_gen_id }} ai-magazine-grid-{{ ai_gen_id }}--layout-{{ block.settings.layout_style }}"
  {{ block.shopify_attributes }}
>
  {% for i in (1..12) %}
    {% liquid
      assign image_key = 'image_' | append: i
      assign title_key = 'title_' | append: i
      assign subtitle_key = 'subtitle_' | append: i
      assign link_key = 'link_' | append: i
      assign size_key = 'size_' | append: i

      assign image = block.settings[image_key]
      assign title = block.settings[title_key]
      assign subtitle = block.settings[subtitle_key]
      assign link = block.settings[link_key]
      assign size = block.settings[size_key]%}

    {% if image != blank or title != blank or subtitle != blank %}
      <div class="ai-magazine-grid-item-{{ ai_gen_id }} ai-magazine-grid-item-{{ ai_gen_id }}--{{ size }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-magazine-grid-link-{{ ai_gen_id }}" aria-label="{{ title | default: 'View content' }}"></a>
        {% endif %}

        {% if image != blank %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            class="ai-magazine-grid-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {% else %}
          <div class="ai-magazine-grid-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-magazine-grid-empty-state-{{ ai_gen_id }}">
              Add image {{ i }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.show_overlay %}
          <div class="ai-magazine-grid-overlay-{{ ai_gen_id }}"></div>
        {% endif %}

        {% if title != blank or subtitle != blank %}
          <div class="ai-magazine-grid-content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h3 class="ai-magazine-grid-title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if subtitle != blank %}
              <p class="ai-magazine-grid-subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

