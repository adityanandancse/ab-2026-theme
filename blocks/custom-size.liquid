</custom-size-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomSizeSelector extends HTMLElement {
      constructor() {
        super();
        this.sizeVariantName = this.dataset.sizeVariantName;
        this.customSizeLabel = this.dataset.customSizeLabel;
        this.radio = this.querySelector('.custom-size-radio-{{ ai_gen_id }}');
        this.modal = this.querySelector('.custom-size-modal-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.custom-size-modal-close-{{ ai_gen_id }}');
        this.cancelButton = this.querySelector('.custom-size-form-cancel-{{ ai_gen_id }}');
        this.saveButton = this.querySelector('.custom-size-form-save-{{ ai_gen_id }}');
        this.editButton = this.querySelector('.custom-size-edit-button-{{ ai_gen_id }}');
        this.formFields = this.querySelectorAll('.custom-size-form-field-{{ ai_gen_id }} input');
        this.measurementsDisplay = this.querySelector('.custom-size-measurements-display-{{ ai_gen_id }}');
        this.measurementsList = this.querySelector('.custom-size-measurements-list-{{ ai_gen_id }}');
        this.optionContainer = this.querySelector('.custom-size-option-{{ ai_gen_id }}');
        this.localStorageKey = 'customSizeMeasurements';
        this.variantSelectors = null;
        this.hasCustomSize = false;
        this.savedMeasurements = null;
        this.addToCartForm = null;
      }

      connectedCallback() {
        this.setupEventListeners();
        this.loadSavedMeasurements();
        
        setTimeout(() => {
          this.initializeVariantSelectors();
          this.findAddToCartForm();
          this.restoreSelection();
        }, 300);
      }

      setupEventListeners() {
        this.radio.addEventListener('change', () => {
          if (this.radio.checked) {
            this.selectCustomSize();
          }
        });

        this.editButton.addEventListener('click', () => {
          this.openModal();
        });

        this.closeButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.cancelButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.saveButton.addEventListener('click', () => {
          this.saveCustomSize();
          this.closeModal();
        });

        this.modal.addEventListener('click', (event) => {
          if (event.target === this.modal) {
            this.closeModal();
          }
        });

        document.addEventListener('click', (event) => {
          if (event.target.matches('button[type="submit"][name="add"]') || 
              event.target.closest('button[type="submit"][name="add"]')) {
            if (this.radio.checked && this.hasCustomSize) {
              this.injectHiddenInputs();
            }
          }
        });
      }

      findAddToCartForm() {
        this.addToCartForm = document.querySelector('form[action*="/cart/add"]');
      }

      initializeVariantSelectors() {
        const radioSelectors = document.querySelectorAll('input[type="radio"][name="options[' + this.sizeVariantName + ']"]');
        const dropdownSelector = document.querySelector('select[name="options[' + this.sizeVariantName + ']"]');
        
        if (radioSelectors.length > 0) {
          this.variantSelectors = radioSelectors;
          this.setupRadioSelectors();
        } else if (dropdownSelector) {
          this.variantSelectors = dropdownSelector;
          this.setupDropdownSelector();
        }
      }

      setupRadioSelectors() {
        this.variantSelectors.forEach(radio => {
          radio.addEventListener('change', () => {
            if (radio.checked) {
              this.deselectCustomSize();
            }
          });
        });
      }

      setupDropdownSelector() {
        this.variantSelectors.addEventListener('change', () => {
          if (this.variantSelectors.value && this.variantSelectors.value !== '') {
            this.deselectCustomSize();
          }
        });
      }

      selectCustomSize() {
        this.clearVariantSelections();
        this.disableVariantSelectors();
        
        if (this.savedMeasurements && Object.keys(this.savedMeasurements).length > 0) {
          this.showMeasurementsDisplay();
          this.hasCustomSize = true;
          this.optionContainer.classList.add('selected');
        } else {
          this.openModal();
        }
      }

      deselectCustomSize() {
        this.radio.checked = false;
        this.hasCustomSize = false;
        this.hideMeasurementsDisplay();
        this.enableVariantSelectors();
        this.optionContainer.classList.remove('selected');
        this.removeHiddenInputs();
      }

      clearVariantSelections() {
        if (this.variantSelectors) {
          if (this.variantSelectors instanceof NodeList) {
            this.variantSelectors.forEach(radio => {
              radio.checked = false;
            });
          } else {
            this.variantSelectors.value = '';
          }
        }
      }

      disableVariantSelectors() {
        if (this.variantSelectors) {
          if (this.variantSelectors instanceof NodeList) {
            this.variantSelectors.forEach(radio => {
              radio.closest('.variant-selector, .product-form__input, fieldset')?.classList.add('variant-selector-disabled-{{ ai_gen_id }}');
            });
          } else {
            this.variantSelectors.closest('.variant-selector, .product-form__input, .select')?.classList.add('variant-selector-disabled-{{ ai_gen_id }}');
          }
        }
      }

      enableVariantSelectors() {
        if (this.variantSelectors) {
          if (this.variantSelectors instanceof NodeList) {
            this.variantSelectors.forEach(radio => {
              radio.closest('.variant-selector, .product-form__input, fieldset')?.classList.remove('variant-selector-disabled-{{ ai_gen_id }}');
            });
          } else {
            this.variantSelectors.closest('.variant-selector, .product-form__input, .select')?.classList.remove('variant-selector-disabled-{{ ai_gen_id }}');
          }
        }
      }

      openModal() {
        this.modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        if (this.savedMeasurements) {
          this.formFields.forEach(field => {
            const value = this.savedMeasurements[field.name];
            if (value) {
              field.value = value;
            }
          });
        }
      }

      closeModal() {
        this.modal.style.display = 'none';
        document.body.style.overflow = '';
        
        if (!this.hasCustomSize) {
          this.radio.checked = false;
          this.enableVariantSelectors();
        }
      }

      saveCustomSize() {
        const measurements = {};
        let hasValues = false;
        
        this.formFields.forEach(field => {
          if (field.value.trim()) {
            measurements[field.name] = field.value.trim();
            hasValues = true;
          }
        });
        
        if (hasValues) {
          this.hasCustomSize = true;
          this.savedMeasurements = measurements;
          localStorage.setItem(this.localStorageKey, JSON.stringify(measurements));
          this.radio.checked = true;
          this.showMeasurementsDisplay();
          this.optionContainer.classList.add('selected');
          this.disableVariantSelectors();
          
          // Inject hidden inputs immediately after saving
          this.injectHiddenInputs();
        } else {
          this.deselectCustomSize();
        }
      }

      showMeasurementsDisplay() {
        if (!this.savedMeasurements) return;
        
        this.measurementsList.innerHTML = '';
        
        Object.entries(this.savedMeasurements).forEach(([key, value]) => {
          if (value) {
            const item = document.createElement('div');
            item.className = 'custom-size-measurement-item-{{ ai_gen_id }}';
            item.innerHTML = `
              <span>${key}:</span>
              <span>${value} {{ block.settings.measurement_unit }}</span>
            `;
            this.measurementsList.appendChild(item);
          }
        });
        
        this.measurementsDisplay.classList.add('show');
      }

      hideMeasurementsDisplay() {
        this.measurementsDisplay.classList.remove('show');
      }

      loadSavedMeasurements() {
        const saved = localStorage.getItem(this.localStorageKey);
        if (saved) {
          try {
            this.savedMeasurements = JSON.parse(saved);
          } catch (e) {
            console.error('Error parsing saved measurements:', e);
            this.savedMeasurements = null;
          }
        }
      }

      restoreSelection() {
        const savedSelection = localStorage.getItem('customSizeSelection');
        if (savedSelection === 'custom' && this.savedMeasurements && Object.keys(this.savedMeasurements).length > 0) {
          this.radio.checked = true;
          this.selectCustomSize();
          
          // Inject hidden inputs on page load if custom size was previously selected
          this.injectHiddenInputs();
        }
      }

      injectHiddenInputs() {
        if (!this.savedMeasurements || !this.addToCartForm) return;
        
        // First remove any existing inputs
        this.removeHiddenInputs();
        
        // Create a flag input to indicate custom size is selected
        const customSizeFlag = document.createElement('input');
        customSizeFlag.type = 'hidden';
        customSizeFlag.name = 'properties[_Custom Size]';
        customSizeFlag.value = 'Yes';
        customSizeFlag.className = 'custom-size-property-{{ ai_gen_id }}';
        this.addToCartForm.appendChild(customSizeFlag);
        
        // Create inputs for each measurement
        Object.entries(this.savedMeasurements).forEach(([key, value]) => {
          if (value) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = `properties[${key}]`;
            input.value = value + ' {{ block.settings.measurement_unit }}';
            input.className = 'custom-size-property-{{ ai_gen_id }}';
            this.addToCartForm.appendChild(input);
          }
        });
        
        localStorage.setItem('customSizeSelection', 'custom');
      }

      removeHiddenInputs() {
        if (!this.addToCartForm) return;
        
        const existingInputs = this.addToCartForm.querySelectorAll('.custom-size-property-{{ ai_gen_id }}');
        existingInputs.forEach(input => input.remove());
        
        localStorage.removeItem('customSizeSelection');
      }
    }

    customElements.define('custom-size-selector-{{ ai_gen_id }}', CustomSizeSelector);
  })();
</script>

