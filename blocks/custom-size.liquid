{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .custom-size-selector-{{ ai_gen_id }} {
    margin-top: 20px;
  }

  .custom-size-option-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    margin-top: 10px;cursor: pointer;
    padding: 10px;
    border: 2px solid transparent;
    border-radius: {{ block.settings.option_border_radius }}px;
    transition: all 0.3s ease;
  }

  .custom-size-option-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.selected_border_color }};
    background-color: {{ block.settings.selected_background_color }};
  }

  .custom-size-option-{{ ai_gen_id }} input {
    margin-right: 8px;
  }

  .custom-size-measurements-display-{{ ai_gen_id }} {
    margin-top: 10px;
    padding: 10px;
    background-color: {{ block.settings.measurements_display_bg }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    display: none;
  }

  .custom-size-measurements-display-{{ ai_gen_id }}.show {
    display: block;
  }

  .custom-size-measurement-item-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
  }

  .custom-size-measurement-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .custom-size-edit-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.edit_button_color }};
    text-decoration: underline;
    cursor: pointer;
    font-size: 12px;
    margin-top: 5px;
  }

  .custom-size-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
  }

  .custom-size-modal-content-{{ ai_gen_id }} {
    background-color: #fff;
    padding: 30px;
    border-radius: {{ block.settings.border_radius }}px;
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .custom-size-modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 24px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-size-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .custom-size-form-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 10px;
    color: {{ block.settings.title_color }};
  }

  .custom-size-form-description-{{ ai_gen_id }} {
    margin-bottom: 20px;
    color: {{ block.settings.text_color }};
  }

  .custom-size-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .custom-size-form-field-{{ ai_gen_id }} label {
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .custom-size-form-field-{{ ai_gen_id }} input {
    padding: 10px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .custom-size-form-field-{{ ai_gen_id }} .field-note {
    font-size: 12px;
    color: {{ block.settings.note_color }};
  }

  .custom-size-form-buttons-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    gap: 10px;
  }

  .custom-size-form-button-{{ ai_gen_id }} {
    padding: 12px 20px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    cursor: pointer;
    flex: 1;
    border: none;
  }

  .custom-size-form-cancel-{{ ai_gen_id }} {
    background-color: {{ block.settings.cancel_button_color }};
    color: {{ block.settings.cancel_button_text_color }};
  }

  .custom-size-form-save-{{ ai_gen_id }} {
    background-color: {{ block.settings.save_button_color }};
    color: {{ block.settings.save_button_text_color }};
  }

  .custom-size-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    margin-left: 8px;
  }

  .variant-selector-disabled-{{ ai_gen_id }} {
    opacity: 0.5;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .custom-size-modal-content-{{ ai_gen_id }} {
      padding: 20px;
      width: 95%;
    }
  }
{% endstyle %}

<custom-size-selector-{{ ai_gen_id }}
  class="custom-size-selector-{{ ai_gen_id }}"
  data-size-variant-name="{{ block.settings.size_variant_name }}"
  data-custom-size-label="{{ block.settings.custom_size_label }}"
  {{ block.shopify_attributes }}
>
  <div class="custom-size-option-{{ ai_gen_id }}">
    <input 
      type="radio" 
      id="custom-size-radio-{{ ai_gen_id }}" 
      name="size-selection-{{ ai_gen_id }}" 
      value="custom"
      class="custom-size-radio-{{ ai_gen_id }}"
    >
    <label for="custom-size-radio-{{ ai_gen_id }}">{{ block.settings.custom_size_label }}</label>
  </div>

  <div class="custom-size-measurements-display-{{ ai_gen_id }}">
    <div class="custom-size-measurements-list-{{ ai_gen_id }}"></div>
    <button type="button" class="custom-size-edit-button-{{ ai_gen_id }}">Edit measurements</button>
  </div>

  <div class="custom-size-modal-{{ ai_gen_id }}">
