                  "blocks": {}
                },
                "text_6pNCKi": {
                  "type": "text",
                  "settings": {
                    "text": "<p>A leading name in contemporary luxury, the Achin Bindlish brand is an experimental workshop where heritage meets modern artistry. Unfettered by fleeting trends, the creations of the label represent a deep exploration of Indian cultural roots reimagined for a global audience, serving as precursors to a new era of heirloom couture.</p><p>At the heart of our principles are the values of uncompromised quality, the valorization of manual labor, and the absolute freedom of creative expression.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
