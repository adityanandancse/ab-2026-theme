              },
              "blocks": {
                "answer_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Choose Custom size on any piece and enter your measurements, or book a fitting at the atelier or by video. We cut and finish the piece to your measurements.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
