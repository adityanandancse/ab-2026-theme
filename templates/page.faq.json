              },
              "block_order": ["answer_1"]
            },
            "row_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How long does a made-to-measure piece take?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "answer_2": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Most made-to-measure pieces take 4–6 weeks from your final measurements. Heavily embroidered couture can take 8–12 weeks.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
