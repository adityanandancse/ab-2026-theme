                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": ["answer_2"]
            },
            "row_3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I send my measurements from home?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "answer_3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Use our How to measure guide, then enter your measurements under Custom size. We'll check them with you on WhatsApp before we cut.</p>",
